# Cloudflare Pages response headers.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Static assets rarely change — cache them at the edge and in the browser.
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/*.css
  Cache-Control: public, max-age=86400
/*.js
  Cache-Control: public, max-age=86400

# Roto is the exception: its multiplayer client talks a versioned protocol to the
# DraftRoom Worker, and the two deploy separately. A day-old cached module could be
# speaking last week's protocol, so keep these short-lived rather than cache-busted.
/roto/*
  Cache-Control: public, max-age=60, must-revalidate
