# Cloudflare Pages response headers for bcs.jaredluyster.com
# This is an internal roadmap page — keep it out of search indexes and caches
# light since it'll be edited as the plan changes.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  X-Robots-Tag: noindex, nofollow

/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
